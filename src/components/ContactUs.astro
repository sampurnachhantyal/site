---
// Minimal contact section — reuses the company contact details from the footer.
const contactDetails = [
  {
    label: "Address",
    value: "Kupandole, Kandevsthan, Lalitpur, Nepal",
    href: null,
    icon: `<path fill-rule="evenodd" d="M12 2a8 8 0 0 1 6.6 12.6l-.1.1-.6.7-5.1 6.2a1 1 0 0 1-1.6 0L6 15.3l-.3-.4-.2-.2v-.2A8 8 0 0 1 11.8 2Zm3 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" clip-rule="evenodd"/>`,
  },
  {
    label: "Phone",
    value: "980-6394661",
    href: "tel:9806394661",
    icon: `<path d="M8 4a2.6 2.6 0 0 0-2 .9 6.2 6.2 0 0 0-1.8 6 12 12 0 0 0 3.4 5.5 12 12 0 0 0 5.6 3.4 6.2 6.2 0 0 0 6.6-2.7 2.6 2.6 0 0 0-.7-3L18 12.9a2.7 2.7 0 0 0-3.8 0l-.6.6a.8.8 0 0 1-1.1 0l-1.9-1.8a.8.8 0 0 1 0-1.2l.6-.6a2.7 2.7 0 0 0 0-3.8L10 4.9A2.6 2.6 0 0 0 8 4Z"/>`,
  },
  {
    label: "Email",
    value: "info@threadcodetech.com",
    href: "mailto:info@threadcodetech.com",
    icon: `<path d="M2 5.6V18c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V5.6l-.9.7-7.9 6a2 2 0 0 1-2.4 0l-8-6-.8-.7Z"/><path d="M20.7 4.1A2 2 0 0 0 20 4H4a2 2 0 0 0-.6.1l.7.6 7.9 6 7.9-6 .8-.6Z"/>`,
  },
];
---

<section class="pt-20 pb-16 lg:pt-40 lg:pb-24 bg-white dark:bg-gray-900 antialiased">
  <div class="px-4 mx-auto max-w-screen-xl">
    <div class="max-w-2xl mb-12 lg:mb-16">
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight leading-none md:text-5xl xl:text-6xl text-gray-900 dark:text-white">
        Get in touch
      </h1>
      <p class="font-light text-gray-500 md:text-lg lg:text-xl dark:text-gray-400">
        Have a project in mind, a question, or want to work with us? We'd love to hear from you. Reach out through any of the channels below and we'll get back to you.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        contactDetails.map((detail) => (
          <div class="flex flex-col p-6 bg-gray-50 rounded-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
            <span class="flex items-center justify-center w-12 h-12 mb-5 rounded-lg bg-gray-100 dark:bg-gray-700">
              <svg class="w-6 h-6 text-logo-color dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" set:html={detail.icon} />
            </span>
            <h2 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">{detail.label}</h2>
            {detail.href ? (
              <a href={detail.href} class="font-light text-gray-500 dark:text-gray-400 hover:text-logo-color dark:hover:text-white break-words">
                {detail.value}
              </a>
            ) : (
              <p class="font-light text-gray-500 dark:text-gray-400">{detail.value}</p>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-12">
      <a
        href="mailto:info@threadcodetech.com"
        class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-center text-white rounded-lg bg-threadcode-color hover:opacity-90 focus:ring-4 focus:ring-blue-200 dark:focus:ring-blue-900"
      >
        Email us
        <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
