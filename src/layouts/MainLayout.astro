---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../constants";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
const {
  title = "Empowering Innovation in IT Solutions",
  description = "Threadcode Technologies",
  image = "/images/threadcode-tech-logo.png",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={SITE_DESCRIPTION}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:image" content={image} />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.0/flowbite.js"
      integrity="sha512-BJ/5sR2hFxQTKin/55JQCcMTObShDBAmVjL/3NR/MVcrhyOazJjAgvROem03+HYyGw16SVdSfoWCFGr9syxAKA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"></script>
    <title>{SITE_TITLE} - {title}</title>
    <script is:inline>
      // Apply the theme before paint to avoid a flash — on initial load and
      // before each client-side navigation swap (astro:after-swap).
      function applyTheme() {
        const stored = localStorage.getItem("color-theme");
        const dark =
          stored === "dark" ||
          (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body class="min-h-screen">
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    --logo-color: #2a579a;
  }
  * {
    font-family: "Poppins", sans-serif;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    /* background-color: #FFFFF0; */
    background-color: #f7f9ff;
    scroll-behavior: smooth;
    /* background-color: #E5F0FF; */
  }
  html.dark,
  html.dark body {
    background-color: #111827;
  }
  .bg-offblue {
    background-color: #f7f9ff;
  }
  .bg-threadcode-color {
    background-color: var(--logo-color);
  }
  .text-logo-color {
    color: var(--logo-color);
  }
  .card-readmore {
    color: var(--logo-color);
  }
  html.dark .card-readmore {
    color: #60a5fa;
  }
  .sub-heading {
    font-weight: 600;
    font-size: 20px;
    line-height: 28px;
    /* identical to box height, or 138% */
    letter-spacing: 0.1em;
    color: var(--logo-color);
    text-transform: uppercase;
  }
  .h-22 {
	height: 5.5rem;
  }
  .sm\:h-22 {
	height: 5.5rem;
  }
</style>
<script>
  // Runs on initial load and after every client-side navigation, because the
  // navbar (and its toggle button) is re-rendered on each page swap.
  function setupThemeToggle() {
    const darkIcon = document.getElementById("theme-toggle-dark-icon");
    const lightIcon = document.getElementById("theme-toggle-light-icon");
    const btn = document.getElementById("theme-toggle");
    if (!btn || !darkIcon || !lightIcon) return;

    // Show the icon for the theme the user would switch TO.
    const isDark = document.documentElement.classList.contains("dark");
    darkIcon.classList.toggle("hidden", isDark);
    lightIcon.classList.toggle("hidden", !isDark);

    btn.addEventListener("click", () => {
      const nowDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("color-theme", nowDark ? "dark" : "light");
      darkIcon.classList.toggle("hidden", nowDark);
      lightIcon.classList.toggle("hidden", !nowDark);
    });

    // Re-initialise Flowbite components (e.g. the mobile menu) after a swap.
    const initFlowbite = (window as unknown as { initFlowbite?: () => void }).initFlowbite;
    if (typeof initFlowbite === "function") initFlowbite();
  }

  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
